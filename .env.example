# EDISYS · variables del compose (copia a .env). Sin secretos reales aquí.
POSTGRES_PASSWORD=edisys
JWT_SECRET=cambia-esto-por-32-bytes-o-mas-aleatorios
COOKIE_SECURE=false            # true en el EC2 con TLS
URL_PUBLICA=http://localhost:4700
APP_VERSION=local
# Garage: la clave de acceso es «GK» + 24 hex y el secreto 64 hex (se importan solos al arrancar).
S3_ACCESS_KEY=GK0e615b1c2d3e4f5a6b7c8d9e
S3_SECRET_KEY=7d1f0c9b8a7e6d5c4b3a29181716151413121110a9b8c7d6e5f4a3b2c1d0e9f8
S3_BUCKET=edisys-privado
GARAGE_RPC_SECRET=4f2a9c1e7b3d5a8f0c6e2b9d4a7f1c3e5b8d0a2f6c9e1b4d7a3f5c8e0b2d6a9f
GARAGE_ADMIN_TOKEN=garage-admin-local
# Semilla del servicio migrate: si_vacia (defecto) | siempre | no
SEMBRAR=si_vacia
SEMBRAR_PENDIENTES=0           # deja N lecturas de setiembre sin tomar (demo en vivo)
# WhatsApp: simulado (defecto, no envía nada) | evolution (envía de verdad por Evolution API)
WHATSAPP_MODO=simulado
EVOLUTION_URL=
EVOLUTION_INSTANCIA=
EVOLUTION_APIKEY=
WHATSAPP_WEBHOOK_TOKEN=
# SUNAT beta: usuario y clave SOL de pruebas del servidor (respaldo si el edificio
# no tiene las suyas; el certificado .pfx se sube por edificio en la app).
SUNAT_BETA_URL=
SUNAT_BETA_USUARIO=
SUNAT_BETA_CLAVE=
