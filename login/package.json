{
  "name": "edisys-login",
  "description": "EDISYS · pantalla 01 (login) en Qwik City con SSR en Node",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && vite build -c adapters/node-server/vite.config.ts && tsc --noEmit",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/node-server/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "serve": "node server/entry.node-server",
    "qwik": "qwik",
    "prebuild": "node scripts/sync-tokens.mjs",
    "predev": "node scripts/sync-tokens.mjs"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.1",
    "@builder.io/qwik-city": "^1.20.1",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "5.4.5",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "dependencies": {
    "undici": "^8.11.2"
  }
}
