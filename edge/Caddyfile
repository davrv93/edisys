# EDISYS · borde. En local sin TLS (:80 → host 4700). En el EC2 se cambia la dirección
# por el dominio (edisys.pe) y Caddy saca el certificado solo.
{
	admin off
	auto_https off
}

{$EDGE_DIRECCION::80} {
	encode zstd gzip

	# API (Go). Garage/MinIO no se publica: las fotos salen firmadas por /api/v1/archivos/{id}.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080} {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Login (Qwik City). Vive bajo /login: NO se quita el prefijo.
	handle /login* {
		reverse_proxy {$LOGIN_UPSTREAM:login:3000}
	}

	# App (Astro estático con islas React), base /app.
	handle /app* {
		root * /srv
		@inmutable path /app/_astro/*
		header @inmutable Cache-Control "public, max-age=31536000, immutable"
		header /app/sw.js Cache-Control "no-cache"
		try_files {path} {path}/index.html /app/index.html
		file_server
	}

	# No hay landing pública: la raíz manda a la app.
	handle / {
		redir * /app/ 302
	}

	handle {
		redir * /app/ 302
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	log {
		output stdout
		format console
	}
}
