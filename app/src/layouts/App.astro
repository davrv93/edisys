---
// Layout común de las vistas de EDISYS. Astro sirve el HTML estático;
// la isla React (client:only) hace la guarda de sesión (/api/v1/yo), el armazón por rol y la pantalla.
import '../index.css';
import Isla from '../islas/Isla.jsx';

interface Props {
  titulo: string;
  pantalla: string;
  descripcion?: string;
}
const { titulo, pantalla, descripcion = 'EDISYS: administración de edificios.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0F172A" />
    <meta name="description" content={descripcion} />
    <meta name="robots" content="noindex" />
    <title>{titulo} · EDISYS</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/icon-192.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Isla client:only="react" pantalla={pantalla}>
      <div slot="fallback" class="flex min-h-screen flex-col items-center justify-center gap-4 bg-fondo" role="status">
        <svg width="48" height="48" viewBox="0 0 32 32" aria-hidden="true" class="animate-latido-suave">
          <rect width="32" height="32" rx="8" fill="#155E75"></rect>
          <path d="M8 24h16M10.5 19h11M13 14h6M16 9v0.01" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round"></path>
        </svg>
        <p class="text-sm text-texto-apoyo">Cargando {titulo.toLowerCase()}…</p>
      </div>
    </Isla>
    <noscript>
      <p style="padding:16px;font-family:system-ui">EDISYS necesita JavaScript para funcionar.</p>
    </noscript>
  </body>
</html>
