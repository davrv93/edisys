# EDISYS · motor conversacional (F0 · benchmark). Copia a .env; los defectos sirven.
# Ruta del GGUF DENTRO del contenedor (el volumen ./models se monta en /models).
# benchmark.sh la cambia por cada candidato; aquí queda el principal del plan.
MODELO_RUTA=/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
# Techo de RAM de llama-server (§1 del plan: 1 450 MB con ctx 2048).
MEM_LLAMA=1450m
LLAMA_CTX=2048
LLAMA_THREADS=2
# Puerto del host, solo en 127.0.0.1: en F1 lo publica caddy con TLS y token.
LLAMA_PORT=8081
